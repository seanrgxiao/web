pipeline {
  agent {
    kubernetes {
      yaml '''
        apiVersion: v1
        kind: Pod
        spec:
          containers:
          - name: python
            image: python:3.13-slim
            command: ['sleep']
            args: ['infinity']
          - name: docker
            image: docker:24-dind
            securityContext:
              privileged: true
            command: ['sleep']
            args: ['infinity']
      '''
    }
  }

  environment {
    REGISTRY   = 'harbor.chengyingpay.com'          // ← 改成你的 Harbor 地址
    PROJECT    = 'k8s-interview'                     // ← 改成你的 Harbor 项目名
    IMAGE_NAME = 'fastapi-app'
    IMAGE      = "${REGISTRY}/${PROJECT}/${IMAGE_NAME}:${env.BUILD_NUMBER}"
    IMAGE_LATEST = "${REGISTRY}/${PROJECT}/${IMAGE_NAME}:latest"
  }

  stages {
    stage('1. 拉代码') {
      steps {
        checkout scm
      }
    }

    stage('2. 安装依赖 & 单元测试') {
      steps {
        container('python') {
          sh '''
            python -m pip install --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple
            pip install -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple
            pip install pytest httpx -i https://pypi.tuna.tsinghua.edu.cn/simple
            pytest -v
          '''
        }
      }
    }

    stage('3. 打包并推送镜像') {
      steps {
        container('docker') {
          withCredentials([usernamePassword(
            credentialsId: 'harbor',
            usernameVariable: 'HARBOR_USER',
            passwordVariable: 'HARBOR_PASS'
          )]) {
            sh '''
              echo $HARBOR_PASS | docker login $REGISTRY -u $HARBOR_USER --password-stdin
              docker build -t $IMAGE -t $IMAGE_LATEST .
              docker push $IMAGE
              docker push $IMAGE_LATEST
              docker logout $REGISTRY
            '''
          }
        }
      }
    }

    // 可选：更新 GitOps 仓库，让 Argo CD 自动部署
    stage('4. 更新 GitOps manifest') {
      when { branch 'main' }
      steps {
        withCredentials([sshUserPrivateKey(credentialsId: 'git-ssh', keyFileVariable: 'KEY')]) {
          sh '''
            export GIT_SSH_COMMAND="ssh -i $KEY -o StrictHostKeyChecking=no"

            rm -rf tools
            git clone git@github.com:seanrgxiao/tools.git
            cd tools

            MANIFEST="2026/06/260609-k8s-interview-project/gitops/app2/deployment.yaml"
            sed -i "s|image:.*fastapi-app:.*|image: $IMAGE|" $MANIFEST

            git config user.email "jenkins@ci.local"
            git config user.name  "Jenkins CI Bot"
            git add $MANIFEST
            git commit -m "ci: deploy $IMAGE [skip ci]" || echo "no change"
            git push origin main
          '''
        }
      }
    }
  }

  post {
    success { echo "✅ 成功！镜像: ${IMAGE}" }
    failure { echo "❌ 失败" }
  }
}